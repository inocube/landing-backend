# Local development only. Copy to .env and fill in. Never commit .env.
# Production values live in the SAM template or AWS SSM Parameter Store, not here.

AWS_PROFILE=inocube
AWS_REGION=eu-central-1
TABLE_NAME=inocube-leads

# Point boto3 at DynamoDB Local instead of AWS (leave empty to use AWS):
#   docker start dynamodb-local   (first time: docker run -d -p 8000:8000 --name dynamodb-local amazon/dynamodb-local)
DYNAMODB_ENDPOINT=http://localhost:8000
