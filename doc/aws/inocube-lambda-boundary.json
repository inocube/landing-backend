{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeadsTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:UpdateItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:eu-central-1:754895435437:table/inocube-leads",
        "arn:aws:dynamodb:eu-central-1:754895435437:table/inocube-leads/index/*"
      ]
    },
    {
      "Sid": "OwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:eu-central-1:754895435437:log-group:/aws/lambda/inocube-backend-*"
    },
    {
      "Sid": "ProjectParameters",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:eu-central-1:754895435437:parameter/inocube/*"
    },
    {
      "Sid": "SendMailFromOwnDomain",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": "arn:aws:ses:eu-central-1:754895435437:identity/inocube.sk"
    }
  ]
}
